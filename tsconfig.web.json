{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": [],
    "rootDir": "src/web",
    "outDir": "public/js",
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["src/web/**/*.ts"],
  "exclude": ["src/web/**/*.test.ts"]
}
